# Public HTTPS URL of your Vercel website (no trailing slash)
WEB_ORIGIN=https://legendmd.vercel.app

# Optiklink provides this port automatically in most Node.js deployments
PORT=3000

# Keep session files on persistent storage; never commit this folder
SESSION_DIR=./sessions

# Optional: maximum pairing requests per IP per 15 minutes
PAIR_RATE_LIMIT=5
